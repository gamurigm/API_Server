# PostgreSQL estándar en WSL (confirma el puerto con pg_lsclusters).
DATABASE_URL=postgresql://api_gateway_app:REPLACE_ME@127.0.0.1:5434/api_gateway_local
VAULT_ADDR=http://127.0.0.1:43872/
VAULT_TOKEN=REPLACE_WITH_SCOPED_SERVICE_TOKEN
ADMIN_PASSWORD_HASH=REPLACE_WITH_LOCAL_SCRYPT_HASH
GATEWAY_HTTP_PORT=43871

# Optional gateway operational defaults.
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_JSON_LIMIT_BYTES=5242880
GATEWAY_JWKS_CACHE_MS=300000

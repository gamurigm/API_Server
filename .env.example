# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase key. Never expose this value to a browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Comma-separated Google accounts allowed to administer the gateway.
ADMIN_EMAILS=admin@example.com

# Optional operational defaults.
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_JSON_LIMIT_BYTES=5242880
GATEWAY_JWKS_CACHE_MS=300000

# Local testing only. Both flags must stay false/absent in production.
GATEWAY_ALLOW_LOCAL_TEST_HOSTS=false
NEXT_PUBLIC_ENABLE_LOCAL_ADMIN_LOGIN=false

# Values used by scripts/local-fixture.mjs and scripts/setup-local.mjs.
LOCAL_ADMIN_EMAIL=admin@local.test
LOCAL_ADMIN_PASSWORD=CHANGE_ME_FOR_LOCAL_TESTS
LOCAL_FIXTURE_PORT=4010
LOCAL_GATEWAY_PORT=3006
LOCAL_PROVIDER_SECRET=CHANGE_ME_FOR_LOCAL_TESTS

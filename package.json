{
  "name": "federated-api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "gateway": "scripts/gateway.mjs",
    "gateway-tui": "scripts/gateway-tui.mjs"
  },
  "description": "Gateway federado para consumir APIs externas con JWT RS256 existentes.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env.local --import tsx src/server/main.ts",
    "dev:local": "node --env-file=.env.local --import tsx src/server/main.ts",
    "tui": "node --env-file=.env.tui.local scripts/run-tui.mjs",
    "admin:cli": "node --env-file=.env.tui.local scripts/run-cli.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "vault:cleanup": "node --env-file=.env.local scripts/vault-cleanup.mjs",
    "vault:recover": "node --env-file=.env.local scripts/vault-recover.mjs",
    "admin:password": "node --env-file=.env.local --import tsx scripts/set-admin-password.mjs",
    "dev:fixture": "node scripts/local-fixture.mjs",
    "security:check": "node scripts/security-check.mjs",
    "build": "tsc --noEmit",
    "start": "node --env-file=.env.local --import tsx src/server/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run security:check && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "ink": "7.1.1",
    "inquirer": "12.10.0",
    "jose": "6.2.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "eslint": "9.39.5",
    "globals": "^17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}

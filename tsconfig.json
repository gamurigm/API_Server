{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/server/**/*.ts",
    "src/http/**/*.ts",
    "src/lib/**/*.ts",
    "src/tui/**/*.ts",
    "scripts/**/*.mjs",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/**"
  ]
}
